# Copy to .env and replace every value before starting Compose.
FORGEFLOW_DB_PASSWORD=replace_with_a_long_random_database_password
FORGEFLOW_GATEWAY_TOKEN=replace_with_at_least_32_random_characters

# YouTube Magazine adapters remain disabled until these are configured.
YOUTUBE_API_KEY=
YOUTUBE_COLLECTOR_MODE=demo
YOUTUBE_CLIENT_SECRET_PATH=secrets/client_secret.json
YOUTUBE_TOKEN_PATH=secrets/youtube_token.json
DEFAULT_REGION_CODE=KR
DEFAULT_CATEGORY_ID=24
DEFAULT_PRIVACY_STATUS=private
